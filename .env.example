POSTGRES_PASSWORD=
JWT_SECRET=
# Segredo longo e exclusivo usado para proteger comunidades SNMP no banco.
# Gere, por exemplo, com: openssl rand -base64 48
SNMP_CREDENTIAL_ENCRYPTION_KEY=
PRINT_FLEET_POLL_INTERVAL_SECONDS=900
PRINT_FLEET_WORKER_IDLE_SECONDS=2
# Produção deve permanecer em pysnmp. "simulated" é reservado ao E2E isolado.
PRINT_FLEET_SNMP_TRANSPORT=pysnmp
VITE_API_URL=http://127.0.0.1:8010
# ENABLE_DOCS=true   # habilita /docs, /redoc, /openapi.json (desligado por padrão)
